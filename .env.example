# --- LLM synthesis (required) ---------------------------------------------
# LangChain model identifier; switch providers without code changes.
# Examples: openai:gpt-4o, anthropic:claude-sonnet-4-5
LLM_MODEL=openai:gpt-4o

# Provider API keys (set the one matching LLM_MODEL)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- GitHub (optional) -----------------------------------------------------
# Personal access token for the GitHub GraphQL + Search APIs.
# If unset, quarterly-pulse falls back to authenticated `gh api graphql`.
GITHUB_TOKEN=

# --- LinkedIn (optional; prioritized fallback chain) -----------------------
# a) LinkedIn Member Data Portability API token
LINKEDIN_ACCESS_TOKEN=
# c) Third-party public post APIs (first configured one wins)
APIFY_API_TOKEN=
SCRAPECREATORS_API_KEY=
EXA_API_KEY=
